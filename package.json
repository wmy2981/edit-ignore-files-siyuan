{
  "name": "edit-ignore-files-siyuan",
  "version": "0.2.0",
  "description": "Edit the SiYuan ignore files.",
  "main": "src/index.ts",
  "scripts": {
    "dev": "webpack --config webpack.config.js --mode development",
    "build": "webpack --config webpack.config.js --mode production",
    "typecheck": "tsc --noEmit",
    "test": "node -e \"require('node:fs').rmSync('test-dist',{recursive:true,force:true})\" && tsc -p tsconfig.test.json && node --test \"test-dist/test/*.test.js\"",
    "verify:package": "node scripts/verify-package.mjs",
    "render:icon": "node scripts/render-icon.mjs",
    "render:preview": "node scripts/render-preview.mjs"
  },
  "keywords": [
    "siyuan",
    "siyuan-plugin",
    "ignore-files",
    "syncignore",
    "indexignore",
    "searchignore",
    "assets-cleanup-ignore"
  ],
  "author": "wmy2981",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "copy-webpack-plugin": "^14.0.0",
    "css-loader": "^7.1.2",
    "esbuild-loader": "^4.3.0",
    "mini-css-extract-plugin": "^2.9.4",
    "playwright": "^1.56.1",
    "sass": "^1.93.3",
    "sass-loader": "^16.0.5",
    "sharp": "^0.35.5",
    "siyuan": "1.2.9",
    "typescript": "^5.9.3",
    "webpack": "^5.102.1",
    "webpack-cli": "^6.0.1",
    "zip-webpack-plugin": "^4.0.3"
  }
}
