{
  "name": "edit-ignore-files-siyuan",
  "version": "0.2.1",
  "description": "Edit the SiYuan ignore files.",
  "main": "src/index.ts",
  "scripts": {
    "dev": "vite build --watch --mode development",
    "build": "vite build --mode production",
    "typecheck": "tsc --noEmit",
    "test": "node -e \"require('node:fs').rmSync('test-dist',{recursive:true,force:true})\" && tsc -p tsconfig.test.json && node --test \"test-dist/test/*.test.js\"",
    "verify:package": "node scripts/verify-package.mjs",
    "render:icon": "node scripts/render-icon.mjs",
    "render:preview": "node scripts/render-preview.mjs"
  },
  "keywords": [
    "siyuan",
    "siyuan-plugin",
    "ignore-files",
    "syncignore",
    "indexignore",
    "searchignore",
    "assets-cleanup-ignore"
  ],
  "author": "wmy2981",
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "@types/node": "^24.19.4",
    "fflate": "^0.8.3",
    "playwright": "^1.65.1",
    "sass": "^1.108.2",
    "sharp": "^0.35.5",
    "siyuan": "1.3.0",
    "typescript": "^7.0.2",
    "vite": "^8.4.0"
  }
}
